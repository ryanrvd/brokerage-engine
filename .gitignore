# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
env/
.pytest_cache/

# SQLite databases (regenerated by scripts) — except the canonical store
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
!db/yatin.db
# Manual pre-phase DB snapshots (kept locally as fallback; never committed)
db/*.pre*

# Large regeneratable data artefacts
# transfermarkt-datasets.duckdb (~193 MB) is downloaded fresh by scripts/01_download.py
data/transfermarkt-datasets.duckdb
*.duckdb
*.duckdb.wal
# tm_cache/ (~90 MB, 800+ files) is rebuilt by scrape scripts 06/07/11/13
data/tm_cache/
# scisports_cache/ (~16 MB, ~900 files) is rebuilt by the SciSports API client
data/scisports_cache/

# Runtime artefacts produced by the pipeline (preserved on disk for recovery,
# not version control). Spec for these lives in CLAUDE.md "Known issues".
data/manual_flags.staging.xlsx
data/manual_flags.xlsx.bak
data/*.bak

# Excel temp/lock files
~$*.xlsx
~$*.xls
.~lock.*

# Streamlit secrets and local config (NEVER commit secrets.toml)
.streamlit/secrets.toml
.env
.env.local
*.env

# TM session cookie (user-pasted after solving CAPTCHA — NEVER commit)
data/tm_cookie.txt

# Logs
logs/
*.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local config
.claude/

# OS
.DS_Store
Thumbs.db

# Build / dist
build/
dist/
*.egg-info/

# Phase 6 parity-check artifacts (local only, never committed)
.maps_export_parity/
BrokerageWorkbook.pre6.xlsx
pre6_matches.csv
